@host = http://localhost:5271
@accessToken = paste_access_token_here
@adminAccessToken = paste_admin_access_token_here
@lecturerAccessToken = paste_lecturer_access_token_here
@refreshToken = paste_refresh_token_here

### List majors (use an id as majorId when registering or creating a student)
GET {{host}}/api/majors
Accept: application/json

### Register a student (majorId must exist in the database)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "Password123!",
  "studentCode": "STU001",
  "fullName": "Nguyen Van A",
  "majorId": "00000000-0000-0000-0000-000000000001",
  "enrollmentYear": 2026,
  "dateOfBirth": "2007-05-12",
  "gender": "Male",
  "phone": "0900000000"
}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "Password123!"
}

### Rotate refresh token
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Current user
GET {{host}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

### Revoke refresh token
POST {{host}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### List courses
GET {{host}}/api/courses?limit=20
Accept: application/json

### Create course (Admin)
POST {{host}}/api/courses
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "courseCode": "CS101",
  "courseName": "Introduction to Programming",
  "credits": 3,
  "description": "Programming fundamentals"
}

### Get course
GET {{host}}/api/courses/00000000-0000-0000-0000-000000000000
Accept: application/json

### List course sections (Admin)
GET {{host}}/api/course-sections?page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Create course section (Admin; use existing course, semester, and lecturer IDs)
POST {{host}}/api/course-sections
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "courseId": "00000000-0000-0000-0000-000000000001",
  "semesterId": "00000000-0000-0000-0000-000000000002",
  "lecturerId": "00000000-0000-0000-0000-000000000003",
  "sectionCode": "CS101-01",
  "capacity": 40
}

### Generate weekly class sessions (Admin; replace section ID)
POST {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/sessions/generate
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "fromDate": "2026-09-01",
  "toDate": "2026-12-15",
  "timeZoneId": "Asia/Ho_Chi_Minh",
  "weeklySlots": [
    {
      "dayOfWeek": "Monday",
      "startTime": "07:30:00",
      "endTime": "10:00:00",
      "room": "A101"
    },
    {
      "dayOfWeek": "Thursday",
      "startTime": "13:00:00",
      "endTime": "15:30:00",
      "room": "A101"
    }
  ],
  "excludeDates": ["2026-09-02"]
}

### List class sessions for a section (Admin; replace section ID)
GET {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/sessions?from=2026-09-01&to=2026-12-15&timeZoneId=Asia/Ho_Chi_Minh
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Add a student to a course section by student code (Admin; replace section ID)
POST {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/students
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "studentCode": "STU001"
}

### List students enrolled in a course section (Admin; replace section ID)
GET {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/students?page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### List students in one of the signed-in lecturer's course sections
GET {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/students?page=1&pageSize=20
Authorization: Bearer {{lecturerAccessToken}}
Accept: application/json

### Update or cancel one class session (Admin; replace session ID)
PATCH {{host}}/api/class-sessions/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "startAtUtc": "2026-09-03T06:00:00Z",
  "endAtUtc": "2026-09-03T08:30:00Z",
  "room": "A102",
  "topic": "Programming basics",
  "status": "Scheduled",
  "timeZoneId": "Asia/Ho_Chi_Minh"
}

### List all semesters in the system (use an id for the student's semester courses)
GET {{host}}/api/semesters
Accept: application/json

### Create semester (Admin)
POST {{host}}/api/semesters
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "name": "Semester 1",
  "academicYear": "2026-2027",
  "startDate": "2026-09-01",
  "endDate": "2027-01-15"
}

### List grade components for a course section (Admin; replace section ID)
GET {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/grade-components
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### List student grades in a course section (Admin; replace section ID)
GET {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/grades?page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### List student grades in an assigned course section (Lecturer; replace section ID)
GET {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/grades?page=1&pageSize=20
Authorization: Bearer {{lecturerAccessToken}}
Accept: application/json

### Save student grades (Admin or assigned Lecturer; replace section, enrollment, and component IDs)
PUT {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/grades
Authorization: Bearer {{lecturerAccessToken}}
Content-Type: application/json

{
  "items": [
    {
      "enrollmentId": "00000000-0000-0000-0000-000000000002",
      "gradeComponentId": "00000000-0000-0000-0000-000000000003",
      "score": 8.5
    },
    {
      "enrollmentId": "00000000-0000-0000-0000-000000000004",
      "gradeComponentId": "00000000-0000-0000-0000-000000000003",
      "score": null
    }
  ]
}

### Create a grade component (Admin; replace section ID; weight is a percentage)
POST {{host}}/api/course-sections/00000000-0000-0000-0000-000000000001/grade-components
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "name": "Giữa kỳ",
  "weight": 30,
  "maxScore": 10
}

### List students (Admin)
GET {{host}}/api/students?page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Search students by name or student code (Admin)
GET {{host}}/api/students?search=Nguyen&page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### List requests (Admin; optional filters: status, requestType, studentId)
GET {{host}}/api/requests?page=1&pageSize=20&status=Pending
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### List lecturers (Admin)
GET {{host}}/api/lecturers?page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### List course sections assigned to the signed-in lecturer
GET {{host}}/api/lecturers/me/course-sections?page=1&pageSize=20
Authorization: Bearer {{lecturerAccessToken}}
Accept: application/json

### List teaching schedule for a lecturer (Admin; replace lecturer ID)
GET {{host}}/api/lecturers/00000000-0000-0000-0000-000000000003/schedule?from=2026-09-01&to=2026-09-30&timeZoneId=Asia/Ho_Chi_Minh
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### List teaching schedule for the signed-in lecturer
GET {{host}}/api/lecturers/me/schedule?from=2026-09-01&to=2026-09-30&timeZoneId=Asia/Ho_Chi_Minh
Authorization: Bearer {{lecturerAccessToken}}
Accept: application/json

### List this week's class schedule for the signed-in student (Monday through Sunday)
GET {{host}}/api/students/me/schedule?from=2026-09-07&to=2026-09-13&timeZoneId=Asia/Ho_Chi_Minh
Authorization: Bearer {{accessToken}}
Accept: application/json

### List the next scheduled class sessions for the signed-in student
GET {{host}}/api/students/me/schedule/upcoming?limit=10
Authorization: Bearer {{accessToken}}
Accept: application/json

### List registered courses in a semester for the signed-in student (replace semester ID)
GET {{host}}/api/students/me/semesters/00000000-0000-0000-0000-000000000002/courses
Authorization: Bearer {{accessToken}}
Accept: application/json

### View component grades for one enrolled course section (Student; replace section ID)
GET {{host}}/api/students/me/course-sections/00000000-0000-0000-0000-000000000001/grades
Authorization: Bearer {{accessToken}}
Accept: application/json

### Open a class session's attendance roster (Lecturer; replace session ID from schedule)
GET {{host}}/api/class-sessions/00000000-0000-0000-0000-000000000001/attendance
Authorization: Bearer {{lecturerAccessToken}}
Accept: application/json

### Mark attendance for students in the selected class session (Lecturer)
PUT {{host}}/api/class-sessions/00000000-0000-0000-0000-000000000001/attendance
Authorization: Bearer {{lecturerAccessToken}}
Content-Type: application/json

{
  "items": [
    {
      "enrollmentId": "00000000-0000-0000-0000-000000000002",
      "status": "Present",
      "note": null
    },
    {
      "enrollmentId": "00000000-0000-0000-0000-000000000003",
      "status": "Absent",
      "note": "Reported absence"
    }
  ]
}

### Create lecturer (Admin)
POST {{host}}/api/lecturers
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "email": "new.lecturer@example.com",
  "password": "Password123!",
  "lecturerCode": "LEC001",
  "fullName": "Nguyen Van C",
  "phone": "0900000002"
}

### Create student (Admin; majorId must exist in the database)
POST {{host}}/api/students
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "email": "new.student@example.com",
  "password": "Password123!",
  "studentCode": "STU002",
  "fullName": "Nguyen Van B",
  "majorId": "00000000-0000-0000-0000-000000000001",
  "enrollmentYear": 2026,
  "dateOfBirth": "2007-07-14",
  "gender": "Male",
  "phone": "0900000001"
}
